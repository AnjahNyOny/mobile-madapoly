{
  "expo": {
    "name": "Monopoly Madagascar",
    "slug": "monopoly-mada",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1FB25A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.littlefooldev.monopolymada"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1FB25A"
      },
      "package": "com.littlefooldev.monopolymada",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "365e58f0-56ec-483c-893d-4e3b89604fe6"
      }
    }
  }
}
